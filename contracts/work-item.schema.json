{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/contracts/work-item.schema.json",
  "title": "Agent OS Work Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_id",
    "routing_source",
    "source_product",
    "owning_product",
    "workspace",
    "problem_or_opportunity",
    "priority",
    "desired_outcome",
    "required_capabilities",
    "constraints",
    "acceptance_criteria",
    "status",
    "created_at"
  ],
  "properties": {
    "work_id": {"type": "string", "minLength": 1},
    "routing_source": {"const": "registry/product-routing.yaml"},
    "source_product": {"type": "string", "minLength": 1},
    "owning_product": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "problem_or_opportunity": {"type": "object", "minProperties": 1},
    "originating_signal": {"type": "object"},
    "priority": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": {"enum": ["p0", "p1", "p2", "p3"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "evidence": {"type": "array", "items": {"type": "object"}},
    "desired_outcome": {"type": "object", "minProperties": 1},
    "required_capabilities": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "required_tools": {"type": "array", "items": {"type": "string"}},
    "context_references": {"type": "array", "items": {"type": "string"}},
    "authority_class": {"type": "string"},
    "constraints": {"type": "object"},
    "estimated_cost": {"type": "object"},
    "human_oversight": {"type": "object"},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence_destination": {"type": "string"},
    "status": {"enum": ["proposed", "approved", "planning", "blocked", "executing", "verifying", "completed", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
