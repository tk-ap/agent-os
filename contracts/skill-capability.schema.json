{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/contracts/skill-capability.schema.json",
  "title": "Agent OS Skill Capability Declaration",
  "description": "Declared maximum capability envelope for one immutable skill admission. Runtime authority may be narrower but never broader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "admission_id",
    "source",
    "risk_class",
    "filesystem",
    "shell",
    "network",
    "package_install",
    "credentials",
    "external_mutation",
    "control_plane_write",
    "self_modify_permissions"
  ],
  "properties": {
    "skill_id": {"type": "string", "minLength": 1},
    "admission_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_or_artifact", "immutable_ref", "content_digests"],
      "properties": {
        "repository_or_artifact": {"type": "string", "minLength": 1},
        "immutable_ref": {"type": "string", "minLength": 7},
        "content_digests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "minLength": 7}
            }
          }
        }
      }
    },
    "risk_class": {
      "type": "string",
      "enum": ["L0-reference", "L1-local-read", "L2-local-write", "L3-execution", "L4-external", "L5-privileged"]
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "write": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "commands"],
      "properties": {
        "allowed": {"type": "boolean"},
        "commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "destinations"],
      "properties": {
        "allowed": {"type": "boolean"},
        "destinations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "package_install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "managers", "packages"],
      "properties": {
        "allowed": {"type": "boolean"},
        "managers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "packages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "names"],
      "properties": {
        "allowed": {"type": "boolean"},
        "names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "external_mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "systems", "actions"],
      "properties": {
        "allowed": {"type": "boolean"},
        "systems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "control_plane_write": {"const": false},
    "self_modify_permissions": {"const": false},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"shell": {"properties": {"allowed": {"const": false}}}}},
      "then": {"properties": {"shell": {"properties": {"commands": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"network": {"properties": {"allowed": {"const": false}}}}},
      "then": {"properties": {"network": {"properties": {"destinations": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"package_install": {"properties": {"allowed": {"const": false}}}}},
      "then": {
        "properties": {
          "package_install": {
            "properties": {
              "managers": {"maxItems": 0},
              "packages": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"credentials": {"properties": {"allowed": {"const": false}}}}},
      "then": {"properties": {"credentials": {"properties": {"names": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"external_mutation": {"properties": {"allowed": {"const": false}}}}},
      "then": {
        "properties": {
          "external_mutation": {
            "properties": {
              "systems": {"maxItems": 0},
              "actions": {"maxItems": 0}
            }
          }
        }
      }
    }
  ]
}
