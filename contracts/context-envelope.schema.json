{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-os.local/contracts/context-envelope.schema.json",
  "title": "Permissioned Context Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_id", "source", "consumer", "purpose", "references", "permissions", "issued_at"],
  "properties": {
    "envelope_id": {"type": "string"},
    "source": {"const": "alvira-bridge"},
    "consumer": {"type": "object", "required": ["product", "agent_or_workforce"], "properties": {"product": {"type": "string"}, "agent_or_workforce": {"type": "string"}}, "additionalProperties": false},
    "purpose": {"type": "string", "minLength": 1},
    "work_id": {"type": "string"},
    "references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "permissions": {"type": "object", "required": ["read"], "properties": {"read": {"type": "boolean"}, "redistribute": {"type": "boolean", "default": false}}, "additionalProperties": false},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_reference": {"type": "string"}
  }
}

